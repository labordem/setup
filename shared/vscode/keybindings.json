[
  // Fix minimize window on MacOS
  { "key": "cmd+m", "command": "-workbench.action.minimizeWindow" },
  // Create file or/and directory
  {
    "key": "cmd+n",
    "command": "explorer.newFile",
    "when": "isMac && explorerViewletFocus"
  },
  {
    "key": "ctrl+n",
    "command": "explorer.newFile",
    "when": "!isMac && explorerViewletFocus"
  },
  // Quick controls on terminal
  {
    "key": "cmd+shift+j",
    "command": "workbench.action.toggleMaximizedPanel",
    "when": "isMac"
  },
  {
    "key": "ctrl+shift+j",
    "command": "workbench.action.toggleMaximizedPanel",
    "when": "!isMac"
  },
  // Quick controls for editor groups
  {
    "key": "cmd+2",
    "command": "workbench.action.moveEditorToNextGroup",
    "when": "isMac && !multipleEditorGroups"
  },
  {
    "key": "cmd+shift+2",
    "command": "workbench.action.moveEditorToNextGroup",
    "when": "isMac"
  },
  {
    "key": "cmd+shift+1",
    "command": "workbench.action.moveEditorToPreviousGroup",
    "when": "isMac && multipleEditorGroups"
  },
  // Smart wraps
  {
    "key": "alt+w",
    "command": "editor.emmet.action.wrapWithAbbreviation",
    "when": "editorHasSelection"
  },
  {
    "key": "alt+shift+w",
    "command": "editor.action.surroundWithSnippet",
    "when": "editorHasSelection"
  },
  // Select highlights
  {
    "key": "cmd+shift+d",
    "command": "editor.action.selectHighlights",
    "when": "isMac && editorTextFocus"
  },
  {
    "key": "ctrl+shift+d",
    "command": "editor.action.selectHighlights",
    "when": "!isMac && editorTextFocus"
  },
  // Quick rename
  {
    "key": "cmd+shift+r",
    "command": "editor.action.rename",
    "when": "editorTextFocus"
  },
  // Copy lines top / down on Linux like MacOS
  {
    "key": "shift+alt+down",
    "command": "editor.action.copyLinesDownAction",
    "when": "!isMac && editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+shift+alt+down",
    "command": "-editor.action.copyLinesDownAction",
    "when": "!isMac && editorTextFocus && !editorReadonly"
  },
  {
    "key": "shift+alt+up",
    "command": "editor.action.copyLinesUpAction",
    "when": "!isMac && editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+shift+alt+up",
    "command": "-editor.action.copyLinesUpAction",
    "when": "!isMac && editorTextFocus && !editorReadonly"
  },
  // Claude code
  {
    "key": "shift+cmd+i",
    "command": "workbench.view.extension.claude-sidebar-secondary"
  }
]
